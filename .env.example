# Numéro de série tel que défini dans les seeders backend (doggo/database/seeders) —
# contrairement à l'id, il ne change jamais d'un reseed à l'autre.
SERIAL_NUMBER=SN-SIMULATOR-NOVA
ROBOT_DOG_KEY=
MQTT_URL=mqtt://localhost:1883
# Compte MQTT du robot, provisionné côté broker (username = l'id du robot, pas
# son numéro de série — récupérable via GET /api/v1/dogs/by-serial/:serialNumber
# une fois le backend démarré). Voir doggo/docs/mqtt-broker-activation-runbook.md
# pour la commande mosquitto_passwd.
MQTT_PASSWORD=
BACKEND_URL=http://localhost:3333
# Port de la page de visualisation locale (http://localhost:<port>)
VISUALIZATION_PORT=4000
