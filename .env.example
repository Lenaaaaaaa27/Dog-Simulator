# Numéro de série tel que défini dans les seeders backend (doggo/database/seeders) —
# contrairement à l'id, il ne change jamais d'un reseed à l'autre.
SERIAL_NUMBER=SN-SIMULATOR-NOVA
ROBOT_DOG_KEY=
MQTT_URL=mqtt://localhost:1883
# Contre un broker distant en TLS (listener public 8883), utiliser mqtts:// et
# fournir le certificat CA auto-signé du broker (non sensible, mais jamais
# committé — voir .gitignore) :
# MQTT_URL=mqtts://<ip-publique-du-broker>:8883
# MQTT_CA_PATH=./ca.crt
MQTT_CA_PATH=
# Compte MQTT du robot, provisionné automatiquement côté broker à la création
# du robot dans le back-office (Dynamic Security) — username = l'id du robot,
# pas son numéro de série. Récupérable via GET /api/v1/dogs/by-serial/:serialNumber
# une fois le backend démarré.
MQTT_PASSWORD=
BACKEND_URL=http://localhost:3333
# Port de la page de visualisation locale (http://localhost:<port>)
VISUALIZATION_PORT=4000
